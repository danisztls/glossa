# The corpus is NOT in this repository (docs/decisions.md, 2026-08-23). It
# holds verbatim reproductions of texts other people hold rights in, and this
# repository is public; it lives in the private `glossa-corpus` repository,
# expected on disk as a sibling of this one. Both `pipeline/` and `site/`
# resolve it through CORPUS_DIR, defaulting to that sibling.
#
# This rule is a guard, not a policy: nothing should create `corpus/` here
# any more, and if something does, it must not be committed back.
/corpus/

# Python
__pycache__/
.venv/
.ruff_cache/
.pytest_cache/

# Node / SvelteKit
node_modules/
site/.svelte-kit/
site/build/

# Empty dotfiles recreated by Claude Code's sandbox shell init — not project files
.bash_profile
.bashrc
.gitconfig
.gitmodules
.profile
.ripgreprc
.zprofile
.zshrc

# Editor / tooling state, not project files. No trailing slashes: the
# sandbox shell init recreates .idea/.vscode as empty *files*, not dirs.
.claude
.idea
.vscode
.mcp.json

# Misc
.DS_Store
*.log
