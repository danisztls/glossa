# The corpus IS committed, reversing the rule that used to stand here. The
# copyright position, and what a takedown costs now that the texts are in git
# history rather than only in a build, are stated in corpus/README.md; the
# reasoning is in docs/decisions.md.

# Python
__pycache__/
.venv/

# Node / SvelteKit
node_modules/
site/.svelte-kit/
site/build/

# Empty dotfiles recreated by Claude Code's sandbox shell init — not project files
.bash_profile
.bashrc
.gitconfig
.gitmodules
.profile
.ripgreprc
.zprofile
.zshrc

# Editor / tooling state, not project files. No trailing slashes: the
# sandbox shell init recreates .idea/.vscode as empty *files*, not dirs.
.claude
.idea
.vscode
.mcp.json

# Misc
.DS_Store
*.log
