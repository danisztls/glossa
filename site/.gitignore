node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build

# Corpus data, synced from ../corpus by `npm run sync-corpus` (see
# scripts/sync-corpus.mjs and README.md "Corpus data"). Never hand-edit.
/src/lib/corpus-data

# What the last successful sync-corpus run's inputs looked like, for
# --changed-only (scripts/incremental.mjs). Untracked and safe to delete:
# losing it costs one full sync, never a wrong one, because a run records this
# only where it exits 0.
/scripts/.sync-corpus-state.json

# Generated alongside corpus-data by sync-corpus. The edge worker reads this
# compact route manifest before serving the SPA shell; it is deploy output,
# not an editorial source file.
/static/corpus-routes.json
/static/reference-coverage.json
/static/route-titles.json
/static/apparatus.json
/static/works.json

# Also generated, and for the same reason kept out of the tree: sitemap.xml is
# derived from the route manifest by the same sync pass, and security.txt's
# `Expires` rolls forward on every build (scripts/write-security-txt.mjs). A
# committed copy of either would be a stale duplicate of build output.
/static/sitemap.xml
/static/.well-known/

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
