{
	"name": "site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:clean": "rm -rf node_modules/.vite && npm run dev",
		"build": "vite build",
		"preview": "vite preview",
		"preview:edge": "wrangler dev",
		"preview:deploy": "npm run build && npm run preflight && npm run preview:edge",
		"verify": "npm run format:check && npm run check && npm run test",
		"test": "vitest run",
		"verify:calendar": "vitest run --config vitest.oracle.config.ts",
		"test:watch": "vitest",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run check -- --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"sync-corpus": "node scripts/sync-corpus.mjs",
		"sync-corpus:changed": "node scripts/sync-corpus.mjs --changed-only",
		"export": "node scripts/export-book-forms.mjs && node scripts/export-versification.mjs && node scripts/export-section-names.mjs",
		"security-txt": "node scripts/write-security-txt.mjs",
		"coverage:accept": "node scripts/reference-coverage.mjs --accept",
		"lastmod:accept": "node scripts/sync-corpus.mjs --accept-lastmod",
		"preflight": "node scripts/preflight-deploy.mjs",
		"deploy": "npm run build && npm run preflight && wrangler deploy",
		"usage": "node scripts/usage.mjs",
		"predev": "npm run sync-corpus:changed && npm run security-txt",
		"prebuild": "npm run sync-corpus && npm run security-txt",
		"postbuild": "node scripts/minify-build.mjs && node scripts/audit-inlined-corpus.mjs",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@fontsource-variable/eb-garamond": "^5.3.0",
		"@fontsource-variable/source-sans-3": "^5.3.0",
		"@fontsource/amiri": "^5.3.0",
		"@fontsource/frank-ruhl-libre": "^5.3.0",
		"@fontsource/pirata-one": "^5.3.0",
		"@fontsource/ponomar": "^5.3.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"html-minifier-terser": "^7.2.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10",
		"wrangler": "^4.123.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.31.0",
		"fuzzysort": "^4.0.2"
	}
}
