{
	// Cloudflare deploy config for the static site.
	//
	// Workers static assets rather than Cloudflare Pages: Pages' one real
	// advantage here would be Git-integrated builds, and those cannot work for
	// this project — `corpus/` is gitignored and lives only in a local
	// checkout, so a build triggered from the repo would find no corpus and
	// fall back to the two-book test fixtures (see site/README.md and
	// CLAUDE.md's warning about exactly this failure mode, which looks
	// confusing rather than obviously broken). Deploys come from a local
	// `npm run build` either way, which leaves Workers — the platform
	// Cloudflare is still developing — with no cost against it.
	//
	// `src/worker.ts` is deliberately tiny: it validates a request against the
	// corpus-generated route manifest, then hands static assets straight back
	// to the asset binding. It is not an application server and never reads or
	// transforms corpus text. Its one job is preserving a real 404 for an
	// invalid citation while allowing valid deep links to boot the SPA shell.
	"main": "src/worker.ts",
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "glossa",
	"compatibility_date": "2026-08-16",

	// The site answers on one hostname, and it is this one. `workers_dev`
	// defaults to true, which would keep glossa.me-f65.workers.dev serving the
	// same corpus from a second address -- harmless while the site asked not to
	// be crawled, and a duplicate-content problem the moment it stopped
	// (docs/decisions.md, Posture: "Indexable, and a duplicate of vatican.va on
	// purpose"). Turning it off is what makes the canonical address canonical in
	// fact rather than by intention.
	//
	// The route is declared here rather than left to the dashboard so that this
	// file, not an account someone else cannot see, is the record of where the
	// worker is reachable. `custom_domain` (not a plain route pattern) is the
	// form that owns the DNS record and the certificate.
	"workers_dev": false,
	"routes": [{ "pattern": "glossacatholica.org", "custom_domain": true }],
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",

		// Reader URLs are slashless canonical paths. The edge worker performs
		// the redirect for navigation requests before handing the SPA shell back;
		// this setting keeps static HTML assets (notably offline.html) consistent.
		"html_handling": "auto-trailing-slash",

		// The worker, rather than a host-wide SPA fallback, chooses which
		// navigation requests receive index.html. That keeps canonical deep
		// links working while a typo such as /catechismus/999999 remains a real 404.
		"not_found_handling": "404-page",
		"run_worker_first": true
	}
}
