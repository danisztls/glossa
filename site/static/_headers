# Cache policy and content type for the static host (Cloudflare Workers static
# assets reads this file out of the deployed asset directory and does not serve
# it).
#
# Cloudflare's default for every asset is `max-age=0, must-revalidate`, which is
# correct for anything whose URL can outlive its contents — every prerendered
# HTML page, the service worker, the manifest. The rules below are the
# exceptions: paths where the URL changes whenever the bytes do, or where the
# bytes effectively never change.

# Content-hashed by the build. A given URL here can never mean different bytes,
# which is the entire precondition for `immutable`.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are copied from static/ with stable, UNHASHED names, so `immutable` would
# be a year-long commitment to bytes we can no longer change. Long, but
# revalidated, so replacing a font file is still a deploy and not a stuck cache.
/fonts/*
  Cache-Control: public, max-age=2592000

/icons/*
  Cache-Control: public, max-age=2592000

# A `.txt` is served `text/plain` with NO charset, and a `text/plain` without
# one is decoded by the reader's browser default rather than as UTF-8. Every em
# dash in `llms.txt` — 24 of them, in prose written for a machine deciding
# whether to trust this site — arrived as `â€”`, the windows-1252 reading of the
# UTF-8 bytes. Nothing is wrong with the file: the header was silent and the
# guess was wrong.
#
# The site's other text formats are not listed here: JSON is UTF-8 by RFC 8259,
# `.xml` carries its own declaration, and `.html` is answered by `src/worker.ts`
# — which appends the charset itself (`withCharset`), because every address
# reaches the shell through the asset binding at the path `/` and a rule written
# here against the reader's address would never match it. These three are the
# ones that cannot.
# `security.txt` is ASCII today and is listed anyway — it is generated, and a
# file whose correctness depends on nobody adding a typographic mark to it is
# the one that will get one.
/llms.txt
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
